# =============================================================================
# .env.example — plantilla de configuración del agente genealógico (v10.0)
#
# Copia este archivo a .env y rellena tus claves:
#     cp .env.example .env
#
# REGLAS: el .env NUNCA se sube a git/repo (ver .gitignore) y las claves
# jamás se loguean ni se guardan en cache_agente.db.
# =============================================================================

# ----------------------------- CLAVES API -----------------------------------
# Obligatorias: sin ellas config.py para con un mensaje claro.
TAVILY_API_KEY=
OPENROUTER_API_KEY=

# ----------------------------- MODELOS (v10.0) --------------------------------
# Defaults de la v10.0; coméntalos para usar el default del código o
# cámbialos por otro slug de OpenRouter (openrouter.ai/models).
MODELO_FASE1=deepseek/deepseek-v4-flash
# v9.2: fase 2 pasa de z-ai/glm-5.2 a DeepSeek V4.1 Flash (2026-09-10).
MODELO_FASE2=deepseek/deepseek-v4.1-flash
# v10.0: MODELO_VISION se ELIMINA — el OCR y la transcripción de imágenes
# son 100% LOCALES; ya no se manda ninguna imagen a un modelo de la nube.

# v9.2 — Razonamiento opcional del modelo de fase 2 vía OpenRouter.
# Por defecto APAGADO: el razonamiento consume tokens de SALIDA extra
# (más coste) y para extracción estructurada de campos no suele compensar.
# Actívalo solo si notas que la extracción falla en casos complejos.
REASONING_ACTIVADO=false

# v10.2 — Segundos máx. por llamada al LLM (hard timeout del hilo).
# El default de config.py es 45; SÚBELO si ves avisos repetidos del tipo
# "deepseek-... no respondió en 45s": con prompts largos (lotes de
# extracción de fase 2) o el modelo saturado, 45 s se queda corto.
# TIMEOUT_LLM=90

# ------------------------- FAMILYSEARCH (PARTE A) ---------------------------
# Opcional. El catálogo exige login. Camino recomendado: pega la cookie
# fssessionid de tu navegador (F12 -> Network -> Cookie).
# La cookie/contraseña JAMÁS se loguea ni se persiste en la BD.
FAMILYSEARCH_USER=
FAMILYSEARCH_PASS=
FAMILYSEARCH_COOKIE=

# ------------------------- OTROS CONECTORES ---------------------------------
# URL de búsqueda del ADDO (Palencia): el sitio cambia con frecuencia.
ADDO_BUSQUEDA=

# ------------------------- OCR 100% LOCAL (v10.0/v10.1) ---------------------
# Backend: rapidocr (default) | paddleocr | llamacpp | off
# Cascada: pypdf -> OCR local -> fallo explícito (NUNCA escala a la nube).
# Los manuscritos (PARES/SIGA/ADDO...) requieren OCR_BACKEND=llamacpp;
# con otro backend quedan sin texto, con aviso.
OCR_BACKEND=rapidocr
OCR_USE_GPU=true

# llama.cpp + Vulkan (GPU AMD): ver README, sección "OCR local".
# Es el ÚNICO motor local capaz de leer manuscritos (partidas parroquiales).
OCR_LLAMACPP_URL=http://localhost:8080
OCR_LLAMACPP_TIMEOUT_CONEXION=5.0
OCR_LLAMACPP_TIMEOUT_INFERENCIA=60.0

# v10.1 — Familia del modelo servido por llama-server (multi-modelo):
#   glm-ocr  (DEFAULT): ggml-org/GLM-OCR-GGUF, 0.9B, ~2.5 GB VRAM.
#            Recomendado: español explícito + manuscrito 1800-1930, el más
#            rápido. Arranque: llama-server -hf ggml-org/GLM-OCR-GGUF
#   hunyuan  : ggml-org/HunyuanOCR-GGUF (HunyuanOCR-1.5 de Tencent).
#            Alternativa SOTA, 100+ idiomas.
#            Arranque: llama-server -hf ggml-org/HunyuanOCR-GGUF
#   olmocr2  : olmOCR-2-7B (cableado original v9.0, GGUF Q4_K_M + mmproj,
#            ~7 GB VRAM). Especialista en manuscrito anterior a 1800.
#            Comportamiento v10.0 EXACTO.
#   generico : cualquier otro modelo multimodal (define el prompt abajo).
# Valor inválido -> error en el log + fallback conservador a "olmocr2".
OCR_LLAMACPP_FAMILIA=glm-ocr
# Prompt de usuario explícito (opcional): si no está vacío SUSTITUYE al
# prompt por defecto de la familia (para "generico" y pruebas A/B).
OCR_LLAMACPP_PROMPT=
# Reescalado al lado mayor antes de enviar la imagen. Default POR FAMILIA:
# olmocr2=1288 (resolución de entrenamiento); glm-ocr/hunyuan/generico=0
# (sin reescalar: el projector del llama-server gestiona la resolución).
# Vacío = default de familia; un número manda sobre el default; 0 = nunca.
OCR_LLAMACPP_MAX_LADO=

# Reintento anti-Cloudflare con Playwright headless (v4.1).
REINTENTO_HEADLESS=false
